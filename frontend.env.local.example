# Rename this file to .env.local and fill in real values.
# Place it inside the /frontend folder.

# Base URL of the backend API
NEXT_PUBLIC_API_URL=http://localhost:5000

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-32-char-string

# Paystack (public key only — never expose the secret key here)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx

# OAuth (optional, if Google/other providers are enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
