# Rename this file to .env and fill in real values.
# Place it inside the /backend folder.

PORT=5000

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Must match NEXTAUTH_SECRET in the frontend deployment.
NEXTAUTH_SECRET=replace-with-a-random-32-char-string

PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# Create this recurring plan in the Paystack dashboard, then paste its plan code.
PAYSTACK_SUBSCRIPTION_PLAN_CODE=PLN_xxxxxxxxxxxxxxxx
# Your customer-facing site URL, used after hosted Paystack checkout.
FRONTEND_URL=http://localhost:3000
# Optional WhatsApp Business Solution Provider adapter for order updates.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# AI — create a key at console.groq.com and add the same variable in Vercel.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-20b

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
